# Fonnte API Token (get from fonnte.com dashboard)
FONNTE_TOKEN=your_fonnte_token_here

# Your WhatsApp number to receive admin notifications
ADMIN_PHONE=628xxxxxxxxxx

# OpenAI API key — required for the LLM-based bot
OPENAI_API_KEY=sk-...

# Flight status monitoring (free tier: 100 calls/day)
# Sign up at https://aviationstack.com — leave blank to run the poller in stub mode.
AVIATIONSTACK_KEY=

# Shared secret for the /poll endpoint (used when running on serverless via cron).
# Leave blank in dev. In prod, set to a long random string and pass as `x-poll-secret` header.
POLL_SECRET=

# Port (optional, defaults to 3000)
PORT=3000
